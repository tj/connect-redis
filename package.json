{
  "name": "connect-redis",
  "version": "10.0.0",
  "description": "Redis session store for Connect",
  "keywords": [
    "connect",
    "express",
    "redis",
    "session"
  ],
  "bugs": {
    "url": "https://github.com/tj/connect-redis/issues"
  },
  "license": "MIT",
  "author": "TJ Holowaychuk <tj@vision-media.ca>",
  "contributors": [
    "Marc Harter <wavded@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tj/connect-redis.git"
  },
  "type": "module",
  "main": "./dist/connect-redis.cjs",
  "module": "./dist/connect-redis.js",
  "types": "./dist/connect-redis.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/connect-redis.d.ts",
        "default": "./dist/connect-redis.js"
      },
      "require": {
        "types": "./dist/connect-redis.d.cts",
        "default": "./dist/connect-redis.cjs"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "vite build",
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "tsc --noemit && oxlint . && oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt ."
  },
  "devDependencies": {
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.5.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "express-session": "^1.19.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "redis": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "express-session": ">=1",
    "redis": ">=5"
  },
  "overrides": {
    "rollup": "^4.59.0"
  },
  "engines": {
    "node": ">=22"
  }
}
