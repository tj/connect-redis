{
  "name": "connect-redis",
  "version": "10.0.0",
  "description": "Redis session store for Connect",
  "keywords": [
    "connect",
    "express",
    "redis",
    "session"
  ],
  "bugs": {
    "url": "https://github.com/tj/connect-redis/issues"
  },
  "license": "MIT",
  "author": "TJ Holowaychuk <tj@vision-media.ca>",
  "contributors": [
    "Marc Harter <wavded@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tj/connect-redis.git"
  },
  "type": "module",
  "main": "./dist/connect-redis.js",
  "types": "./dist/connect-redis.d.ts",
  "exports": {
    ".": {
      "types": "./dist/connect-redis.d.ts",
      "import": "./dist/connect-redis.js"
    }
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "rm -rf dist && bun build index.ts --target node --packages external --outfile dist/connect-redis.js && tsc index.ts --ignoreConfig --declaration --emitDeclarationOnly --outDir dist && mv dist/index.d.ts dist/connect-redis.d.ts",
    "test": "bun test --coverage",
    "lint": "bun check && bun fmt --check",
    "fix": "bun fmt"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "express-session": "^1.19.0",
    "redis": "^6.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "express-session": ">=1",
    "redis": ">=5"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  }
}
